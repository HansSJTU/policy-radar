      "themes": [
        "family",
        "finances",
        "transition"
      ],
      "summary": {
        "zh": "强调非自愿失业对整个家庭的影响，要求保留60天或足够酌情过渡时间。",
        "en": "Emphasizes family consequences of involuntary job loss and seeks retention or sufficient discretionary transition time."
      },
