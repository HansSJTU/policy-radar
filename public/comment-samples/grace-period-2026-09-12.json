      "themes": [
        "transition",
        "family",
        "talent"
      ],
      "summary": {
        "zh": "要求保留并提高宽限期可预测性，避免家庭不确定性及企业人才损失。",
        "en": "Seeks retention and predictability to reduce family uncertainty and employer talent losses."
