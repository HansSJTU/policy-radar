      "stance": "support",
      "themes": [
        "domestic"
      ],
      "summary": {
        "zh": "支持取消，认为应优先保障美国人的工作机会。",
        "en": "Supports repeal to prioritize jobs for Americans."
      },
      "postedDate": "2026-09-11T04:00:00Z",
      "textSha256": "d826b78ec2e02cfe27ea5f78445c551b95908b917b572a3ada6163a1ff3746e3"
    },
