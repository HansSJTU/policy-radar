      "stance": "oppose",
      "themes": [
        "family",
        "alternatives"
      ],
      "summary": {
        "zh": "认为60天必不可少，希望延至120天，并诉及长期绿卡等待对家庭的影响。",
        "en": "Calls 60 days necessary, seeks 120 days, and describes family hardship during a long green-card wait."
      },
