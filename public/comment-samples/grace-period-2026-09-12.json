      "themes": [
        "domestic"
      ],
      "summary": {
        "zh": "支持取消，认为有助于本土应届毕业生就业，并陈述招聘不公的个人看法。",
        "en": "Supports repeal to improve domestic graduates’ job prospects and describes perceived hiring unfairness."
